#!/bin/sh

. /usr/libexec/camera-tracer/common.sh

expected_generation="${1:-}"
expected_session="${2:-}"
event_dir="${3:-}"
duration="${4:-15}"

ct_is_uint "$duration" || duration=15
[ "$duration" -ge 1 ] 2>/dev/null || duration=1
[ "$duration" -le 120 ] 2>/dev/null || duration=120

sleep "$duration"

current_generation="$(cat "$CT_BASE/generation" 2>/dev/null)"
[ -n "$expected_generation" ] && [ "$current_generation" = "$expected_generation" ] || exit 0

# Snapshot pending ownership before attempting to stop the event. A successful
# on_movie_start removes this marker. If it is still ours after the requested
# duration, Motion acknowledged eventstart but Camera Tracer never observed a
# movie binding. In that failure mode Motion can otherwise keep its webcontrol
# user-event latch asserted and repeatedly invoke on_motion_detected forever.
pending="$(ct_synthetic_pending_read 2>/dev/null || true)"
pending_generation="$(printf '%s\n' "$pending" | sed -n '1p')"
pending_session="$(printf '%s\n' "$pending" | sed -n '2p')"
pending_dir="$(printf '%s\n' "$pending" | sed -n '3p')"
pending_is_ours=0
if [ "$pending_generation" = "$expected_generation" ] && \
   [ "$pending_session" = "$expected_session" ] && \
   [ "$pending_dir" = "$event_dir" ]; then
	pending_is_ours=1
fi

# Event-user ownership is independent of both pending binding and media state.
# movie_max_time can close the first MP4 and movie-end can remove event_dir
# before this deadline. A consumed pending marker is not evidence of eventend.
ended=0
if ct_motion_session_is_current "$expected_session" && \
   ct_synthetic_active_owned "$expected_generation" "$expected_session" "$event_dir"; then
	synthetic="$(ct_synthetic_active_read 2>/dev/null || true)"
	bound_id="$(printf '%s\n' "$synthetic" | sed -n '4p')"
	should_end=1
	if ct_is_uint "$bound_id"; then
		active="$(ct_motion_event_active_read 2>/dev/null || true)"
		active_session="$(printf '%s\n' "$active" | sed -n '1p')"
		active_id="$(printf '%s\n' "$active" | sed -n '2p')"
		if [ "$active_session" = "$expected_session" ] && ct_is_uint "$active_id" && [ "$active_id" != "$bound_id" ]; then
			# A later natural event must not be ended by this old worker even
			# if its earlier on_event_end callback was lost.
			should_end=0
			ct_synthetic_active_clear "$expected_generation" "$expected_session" "$event_dir"
		fi
	fi

	if [ "$should_end" -eq 1 ]; then
		if [ "$pending_is_ours" -eq 1 ]; then
			ct_log "synthetic video did not bind in Motion session $expected_session; issuing fail-safe eventend"
		fi
		if ct_motion_action eventend; then
			ended=1
		else
			sleep 1
			if ct_motion_action eventend; then
				ended=1
			else
				ct_log "failed to end forced synthetic video event ${bound_id:-unbound} after retry; retaining user-event owner"
			fi
		fi
	fi
fi
ct_audio_record_stop "$event_dir"

# Normally on_movie_start has already consumed the pending marker and
# on_movie_end will finalize the event. If no movie ever started, release the
# marker and deliver the accepted event to the local hook with its photo instead
# of waiting forever for an MP4 that does not exist.
sleep 3
if [ "$ended" -eq 1 ]; then
	# on_event_end normally clears this immediately. Also release it after the
	# drain grace if that callback was lost, without touching a newer owner.
	ct_synthetic_active_clear "$expected_generation" "$expected_session" "$event_dir"
fi
pending="$(ct_synthetic_pending_read 2>/dev/null || true)"
pending_generation="$(printf '%s\n' "$pending" | sed -n '1p')"
pending_session="$(printf '%s\n' "$pending" | sed -n '2p')"
pending_dir="$(printf '%s\n' "$pending" | sed -n '3p')"
[ "$pending_generation" = "$expected_generation" ] || exit 0
[ "$pending_session" = "$expected_session" ] || exit 0
[ "$pending_dir" = "$event_dir" ] || exit 0

rm -f "$CT_BASE/synthetic-video-pending"

ct_load_config
config_get hook_script main hook_script ''
photo="$(ct_state_read "$event_dir" photo 2>/dev/null || true)"
source_type="$(ct_state_read "$event_dir" source 2>/dev/null || true)"
trigger_epoch="$(ct_state_read "$event_dir" epoch 2>/dev/null || true)"
trigger_timestamp="$(ct_state_read "$event_dir" timestamp 2>/dev/null || true)"
[ -n "$source_type" ] || source_type='synthetic'
[ -n "$trigger_epoch" ] || trigger_epoch="$(date +%s)"
[ -n "$trigger_timestamp" ] || trigger_timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
ct_log "$source_type event produced no MP4 in Motion session $expected_session; finalizing hook with photo only"
ct_call_hook "$hook_script" "$source_type" "$photo" '' "$trigger_epoch" "$trigger_timestamp" || true

rm -rf "$event_dir"
exit 0
