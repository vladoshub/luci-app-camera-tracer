#!/bin/sh

. /usr/libexec/camera-tracer/common.sh

source_type="${1:-}"
input_photo="${2:-}"
event_id="${3:-}"
motion_session="${4:-}"

case "$source_type" in
	video|audio|timer|mqtt) ;;
	*) exit 2 ;;
esac

ct_load_config
config_get_bool enabled main enabled 0
[ "$enabled" -eq 1 ] || exit 0

# Trusted-presence camera state. The supervisor publishes this state before
# closing Motion, so callbacks racing with camera shutdown cannot enter a new
# alarm/media pipeline. This does not query trusted devices here; all presence
# checks are owned by run-motion-supervisor.
if ct_camera_paused; then
	[ "$source_type" = video ] && rm -f "$input_photo"
	exit 0
fi

# Visual-motion callbacks no longer depend on Motion's picture_output=first.
# on_motion_detected supplies only the Motion event id; after the global holdoff
# reservation succeeds we ask Motion for a fresh snapshot. This lets a long-lived
# Motion event generate another Camera Tracer alarm once the holdoff expires.
# Keep accepting an explicit photo path for compatibility with older/manual calls.
if [ "$source_type" = video ] && [ -n "$input_photo" ] && [ ! -f "$input_photo" ]; then
	exit 0
fi

# LuCI checkboxes establish the initial runtime state; optional MQTT control can
# override it in /tmp. Disabled sources are ignored before reserving the global
# trigger lock.
if ! ct_trigger_enabled "$source_type"; then
	[ "$source_type" = video ] && rm -f "$input_photo"
	exit 0
fi

# One global reservation protects last.jpg/last.mp4 for all trigger sources.
# Timer ticks that arrive before next_allowed are therefore discarded rather
# than queued or delayed, including when timer_interval < effective holdoff.
if ! ct_reserve_event; then
	[ "$source_type" = video ] && rm -f "$input_photo"
	exit 0
fi

config_get photo_name main photo_name 'last.jpg'
if ! ct_safe_photo_name "$photo_name"; then
	ct_log "invalid photo_name '$photo_name', using last.jpg"
	photo_name='last.jpg'
fi

if [ "$source_type" = audio ] && [ ! -x /usr/bin/arecord ]; then
	ct_log "audio trigger requested but alsa-utils/arecord is not installed"
	exit 1
fi

case "$source_type" in
	video)
		if [ -z "$input_photo" ]; then
			rm -f "$CT_RAW/synthetic-snapshot.jpg"
			if ! ct_motion_action snapshot; then
				ct_log "video trigger accepted but Motion snapshot request failed"
				exit 1
			fi
			input_photo="$CT_RAW/synthetic-snapshot.jpg"
			if [ ! -f "$input_photo" ]; then
				sleep 1
			fi
			[ -f "$input_photo" ] || {
				ct_log "video trigger accepted but snapshot file was not created"
				exit 1
			}
		fi
		;;
	audio|timer|mqtt)
		rm -f "$CT_RAW/synthetic-snapshot.jpg" "$CT_RAW/audio-snapshot.jpg" "$CT_RAW/lastsnap.jpg"
		if ! ct_motion_action snapshot; then
			ct_log "$source_type trigger accepted but Motion snapshot request failed"
			exit 1
		fi
		input_photo="$CT_RAW/synthetic-snapshot.jpg"
		if [ ! -f "$input_photo" ]; then
			sleep 1
		fi
		[ -f "$input_photo" ] || {
			ct_log "$source_type trigger accepted but snapshot file was not created"
			exit 1
		}
		;;
esac

final_photo="$CT_BASE/$photo_name"
tmp_photo="$CT_BASE/.${photo_name}.tmp.$$"

if ! cp "$input_photo" "$tmp_photo" 2>/dev/null; then
	ct_log "failed to copy trigger image from $input_photo"
	[ "$source_type" = video ] && rm -f "$input_photo"
	exit 1
fi
mv -f "$tmp_photo" "$final_photo"

case "$input_photo" in
	"$CT_RAW"/*) rm -f "$input_photo" ;;
esac

trigger_timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
generation="$(cat "$CT_BASE/generation" 2>/dev/null)"
[ -n "$generation" ] || exit 0

# Visual callbacks carry the Motion session that produced them. Synthetic
# triggers read the current session after the snapshot request. Session-scoped
# state prevents Motion event ids (which restart from 1 after camera resume)
# from colliding with state left by a previous Motion process.
if [ -z "$motion_session" ]; then
	motion_session="$(ct_motion_session_read 2>/dev/null || true)"
fi
if ! ct_motion_session_is_current "$motion_session"; then
	ct_log "$source_type trigger accepted but Motion session changed; continuing with photo only"
	motion_session=''
fi

event_dir=''
config_get_bool video_enabled main video_enabled 0
config_get_bool video_audio_enabled main video_audio_enabled 0
[ "$video_enabled" -eq 1 ] || video_audio_enabled=0
state_id=''
if [ "$video_enabled" -eq 1 ] && [ -n "$motion_session" ]; then
	case "$source_type" in
		video)
			ct_is_uint "$event_id" && state_id="${motion_session}-event-${event_id}"
			;;
		audio|timer|mqtt)
			# Motion does not expose the event id created by webcontrol eventstart.
			# Use a session-scoped trigger key temporarily; on_movie_start binds the
			# generated Motion event id back to this state directory.
			state_id="${motion_session}-synthetic-${CT_TRIGGER_EPOCH}"
			;;
	esac
fi

if [ -n "$state_id" ]; then
	event_dir="$(ct_event_dir "$generation" "$state_id")" || event_dir=''
	if [ -n "$event_dir" ]; then
		mkdir -p "$event_dir"
		ct_state_write "$event_dir" generation "$generation"
		ct_state_write "$event_dir" motion_session "$motion_session"
		ct_state_write "$event_dir" source "$source_type"
		ct_state_write "$event_dir" photo "$final_photo"
		ct_state_write "$event_dir" epoch "$CT_TRIGGER_EPOCH"
		ct_state_write "$event_dir" timestamp "$trigger_timestamp"

		# Optional microphone audio is captured by the single long-lived ALSA
		# worker. The event only toggles which accepted state directory receives
		# PCM bytes, so trigger detection and clip recording never open the USB
		# microphone twice.
		if [ "$video_audio_enabled" -eq 1 ]; then
			config_get audio_sample_rate main audio_sample_rate '16000'
			case "$audio_sample_rate" in
				8000|16000|32000|44100|48000) ;;
				*) audio_sample_rate=16000 ;;
			esac
			config_get video_audio_bitrate_kbps main video_audio_bitrate_kbps '64'
			ct_is_uint "$video_audio_bitrate_kbps" || video_audio_bitrate_kbps=64
			[ "$video_audio_bitrate_kbps" -ge 16 ] 2>/dev/null || video_audio_bitrate_kbps=16
			[ "$video_audio_bitrate_kbps" -le 192 ] 2>/dev/null || video_audio_bitrate_kbps=192

			config_get fps main fps '5'
			config_get video_pre_capture_frames main video_pre_capture_frames '2'
			ct_is_uint "$fps" || fps=5
			[ "$fps" -ge 1 ] 2>/dev/null || fps=5
			ct_is_uint "$video_pre_capture_frames" || video_pre_capture_frames=0
			audio_delay_ms=$(((video_pre_capture_frames * 1000 + fps - 1) / fps))

			ct_state_write "$event_dir" record_audio '1'
			ct_state_write "$event_dir" audio_sample_rate "$audio_sample_rate"
			ct_state_write "$event_dir" audio_bitrate_kbps "$video_audio_bitrate_kbps"
			ct_state_write "$event_dir" audio_delay_ms "$audio_delay_ms"

			if [ -r "$CT_BASE/audio-worker-ready" ]; then
				if ct_audio_record_start "$generation" "$motion_session" "$event_dir"; then
					ct_log "started microphone capture for $source_type event"
				else
					ct_log "could not arm microphone capture for event"
				fi
			else
				ct_log "MP4 audio requested but audio worker is unavailable; continuing with video-only clip"
			fi
		fi
	fi
fi

# Audio, timer and MQTT-message alarms are synthetic first-class triggers. With video enabled they
# force Motion to start one bounded movie after the immediate snapshot. The
# pending marker is consumed by on_movie_start, and synthetic-video-stop ends
# the forced event at video_max_time so it cannot create unlimited segments.
case "$source_type" in
	audio|timer|mqtt)
		if [ "$video_enabled" -eq 1 ] && [ -n "$event_dir" ]; then
			config_get video_max_time main video_max_time '15'
			ct_is_uint "$video_max_time" || video_max_time=15
			[ "$video_max_time" -ge 1 ] 2>/dev/null || video_max_time=1
			[ "$video_max_time" -le 120 ] 2>/dev/null || video_max_time=120

			# A synthetic alarm must own a fresh Motion event/movie. If natural
			# motion already has an event open, close it first and wait for the
			# on_event_end callback before issuing eventstart. This makes timer,
			# audio and MQTT video independent of Motion's long-lived event state.
			if ct_motion_prepare_synthetic_event "$motion_session" "$source_type" && \
				ct_synthetic_active_write "$generation" "$motion_session" "$event_dir" && \
				ct_synthetic_pending_write "$generation" "$motion_session" "$event_dir" && \
				ct_motion_action eventstart; then
				/usr/libexec/camera-tracer/synthetic-video-stop \
					"$generation" "$motion_session" "$event_dir" "$video_max_time" >/dev/null 2>&1 &
			else
				ct_log "$source_type trigger accepted but a fresh Motion video event could not be started; continuing with photo only"
				# An HTTP failure can race with Motion receiving eventstart. Keep a
				# stop worker for an armed owner even if no movie can be delivered.
				if ct_synthetic_active_owned "$generation" "$motion_session" "$event_dir"; then
					/usr/libexec/camera-tracer/synthetic-video-stop \
						"$generation" "$motion_session" "$event_dir" 1 >/dev/null 2>&1 &
				fi
				ct_audio_record_stop "$event_dir"
				rm -f "$CT_BASE/synthetic-video-pending"
				rm -rf "$event_dir"
				event_dir=''
			fi
		fi
		;;
esac

ct_log "accepted $source_type trigger; photo=$final_photo holdoff=${CT_HOLDOFF}s event=${event_id:-none}"
/usr/libexec/camera-tracer/process-event \
	"$source_type" "$final_photo" "$CT_TRIGGER_EPOCH" "$trigger_timestamp" "$generation" "$event_dir" >/dev/null 2>&1 &
exit 0
