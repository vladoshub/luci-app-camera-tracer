config camera_tracer 'main'
	option enabled '0'
	option video_device '/dev/video0'
	option resolution '640x480'
	option fps '5'
	option video_threshold '1500'
	option trusted_timeout '5'
	option holdoff ''
	option photo_name 'last.jpg'
	option send_photo '1'

	option video_enabled '0'
	option video_name 'last.mp4'
	option video_max_time '15'
	option video_pre_capture_frames '2'
	option video_post_capture_seconds '5'
	option video_quality '60'
	option video_max_size_mb '32'
	option video_audio_enabled '0'
	option video_audio_bitrate_kbps '64'

	option mqtt_enabled '0'
	option mqtt_host ''
	option mqtt_port '1883'
	option mqtt_user ''
	option mqtt_password ''
	option mqtt_tls '0'
	option mqtt_cafile '/etc/ssl/certs/ca-certificates.crt'
	option mqtt_image_topic 'camera_tracer/image'
	option mqtt_video_topic 'camera_tracer/video'
	option mqtt_event_topic 'camera_tracer/event'
	option mqtt_qos '1'

	option hook_script ''

	option audio_enabled '0'
	option audio_device ''
	option audio_sample_rate '16000'
	option audio_threshold_db '-24'
	option audio_trigger_ms '250'
